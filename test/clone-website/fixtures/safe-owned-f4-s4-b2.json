{
  "version": 1,
  "target": {
    "url": "https://store.example.com/",
    "routes": [
      "/",
      "/products"
    ],
    "data_mode": "local-artifacts-only"
  },
  "authorization": {
    "status": "owned",
    "evidence": "The user states that they own the source and destination storefronts.",
    "content_rights": "owned",
    "scope": {
      "routes": ["/", "/products"],
      "deployment": "owner-controlled-production",
      "features": ["cart", "checkout", "external_forms", "identity", "live_customer_data", "payments"],
      "data": ["contact-data", "live-customer-data", "product-data", "source-content", "source-identity"]
    }
  },
  "replica": {
    "fidelity": "F4",
    "scope": "S4",
    "backend_level": "B2",
    "target_stack": "nextjs-typescript",
    "deployment": "owner-controlled-production"
  },
  "limits": {
    "max_pages": 50,
    "max_items": 1000,
    "viewports": [
      {
        "name": "desktop",
        "width": 1440,
        "height": 900
      },
      {
        "name": "mobile",
        "width": 390,
        "height": 844
      }
    ]
  },
  "features": {
    "identity": true,
    "cart": true,
    "checkout": true,
    "payments": true,
    "external_forms": true,
    "live_customer_data": true
  },
  "source_inputs": [],
  "exclusions": []
}
