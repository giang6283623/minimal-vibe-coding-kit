      "executor_transport": "native-subagents",
      "requested_model": "catalog-verified-worker-model-id",
      "requested_reasoning_effort": "medium",
      "read_only": true,
      "paths": ["src/area-a"],
      "instructions": "Inspect area A and return evidence only",
      "expected_artifacts": ["area A report"],
      "validation": [],
      "stop_conditions": [],
      "allow_child_dispatch": false
    },
    {
      "work_id": "work-area-b",
      "task_id": "task-cursor-codex-review",
      "role": "area-b-reader",
      "executor_provider": "cursor",
      "executor_transport": "native-subagents",
      "requested_model": "catalog-verified-worker-model-id",
      "requested_reasoning_effort": "medium",
      "read_only": true,
      "paths": ["src/area-b"],
      "instructions": "Inspect area B and return evidence only",
      "expected_artifacts": ["area B report"],
      "validation": [],
      "stop_conditions": [],
      "allow_child_dispatch": false
    }
  ],
  "trace": [
