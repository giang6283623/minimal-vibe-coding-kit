{
  "taskEnvelope": {
    "version": 2,
    "task_id": "task-cursor-codex-review",
    "objective": "Review two independent repository areas and decide from evidence",
    "controller": "codex",
    "relay": {
      "mode": "automatic-host-relay",
      "resume_controller": true
    },
    "controller_route": {
      "provider": "codex",
      "transport": "mcp",
      "model": "catalog-verified-controller-model-id",
      "reasoning_effort": "high",
      "selection_source": "explicit-user"
    },
    "worker_defaults": {
      "provider": "cursor",
      "transport": "native-subagents",
      "model": "catalog-verified-worker-model-id",
      "reasoning_effort": "medium",
      "selection_source": "explicit-user"
    },
    "topology": "parallel-analysis",
    "scope": {
      "allowed_paths": ["src/area-a", "src/area-b"],
      "protected_paths": []
    },
    "authorization": {
      "mutation": false,
      "external_actions": false
    },
    "budget": {
      "max_workers": 2,
      "max_retries": 1,
      "timeout_ms": 600000
    },
    "acceptance": {
      "commands": [],
      "artifacts": ["area A report", "area B report"],
      "human_gates": []
    }
  },
  "workOrders": [
    {
      "work_id": "work-area-a",
      "task_id": "task-cursor-codex-review",
      "role": "area-a-reader",
