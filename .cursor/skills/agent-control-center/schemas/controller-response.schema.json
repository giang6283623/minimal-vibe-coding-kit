{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal Vibe Coding Kit controller response",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "kind", "work_orders", "question", "decision", "reason", "receipt_bindings"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "kind": {
      "type": "string",
      "enum": ["work-orders", "ask-user", "control-decision"]
    },
    "work_orders": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work_id",
          "task_id",
          "role",
          "executor_provider",
          "executor_transport",
          "requested_model",
          "requested_reasoning_effort",
          "read_only",
          "paths",
          "instructions",
          "expected_artifacts",
          "validation",
          "stop_conditions",
          "allow_child_dispatch"
        ],
        "properties": {
          "work_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "task_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "role": { "type": "string", "minLength": 1, "maxLength": 160 },
          "executor_provider": { "type": "string", "minLength": 1, "maxLength": 80 },
          "executor_transport": { "type": "string", "minLength": 1, "maxLength": 80 },
          "requested_model": { "type": "string", "minLength": 1, "maxLength": 120 },
          "requested_reasoning_effort": { "type": "string", "minLength": 1, "maxLength": 40 },
          "read_only": { "type": "boolean" },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
          },
          "instructions": { "type": "string", "minLength": 1, "maxLength": 64000 },
          "expected_artifacts": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
          },
          "validation": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
          },
          "stop_conditions": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
          },
          "allow_child_dispatch": { "type": "boolean", "const": false }
        }
      }
    },
    "question": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["question_id", "prompt", "options", "recommended_option"],
      "properties": {
        "question_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "recommended_option": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "decision": {
      "type": ["string", "null"],
      "enum": ["accept", "retry", "escalate", "stop", null]
    },
    "reason": { "type": ["string", "null"], "maxLength": 4000 },
    "receipt_bindings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "receipt_digest"],
        "properties": {
          "work_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "receipt_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
